# Copy this file to .env for local development. Never commit real credentials.
BOT_TOKEN=
MINIAPP_URL=
ADMIN_IDS=
# Either TG_API_ID/TG_API_HASH or TELEGRAM_API_ID/TELEGRAM_API_HASH is supported.
TG_API_ID=
TG_API_HASH=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Keep Telethon session and SQLite data on persistent storage.
TG_SESSION=/app/data/linkcheck_telegram
DB_PATH=/app/data/linkcheck.db
INIT_DATA_MAX_AGE=86400
